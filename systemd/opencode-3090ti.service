[Unit]
Description=OpenCode Ollama stack (Docker)
Documentation=https://github.com/brianlechthaler/opencode-3090ti
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=INSTALL_DIR=/opt/opencode-3090ti
ExecStart=/opt/opencode-3090ti/scripts/start.sh
ExecReload=/opt/opencode-3090ti/scripts/start.sh
TimeoutStartSec=300

# Layer 1 redundancy: systemd restarts the start script on failure.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
